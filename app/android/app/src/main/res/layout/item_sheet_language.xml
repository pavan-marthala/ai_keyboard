<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/languageRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_atfix_row"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/languageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sheet_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/languageNative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sheet_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/languageCommand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_atfix_chip"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/sheet_chip_text"
        android:textSize="12sp"
        android:typeface="monospace" />
</LinearLayout>
